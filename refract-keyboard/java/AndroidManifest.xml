<?xml version="1.0" encoding="utf-8"?>
<!--
     Refract Keyboard manifest.

     LatinIME rendering and input code comes from AOSP. Network dictionaries, contacts,
     spell-check, sync, backup, and download components are intentionally not exposed.
-->
<manifest
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission
        android:name="android.permission.ACCESS_NETWORK_STATE"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.INTERNET"
        tools:node="remove" />
    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher_keyboard"
        android:label="@string/refract_app_name"
        android:supportsRtl="true"
        android:usesCleartextTraffic="false">

        <service
            android:name=".LatinIME"
            android:exported="true"
            android:label="@string/refract_app_name"
            android:permission="android.permission.BIND_INPUT_METHOD">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data
                android:name="android.view.im"
                android:resource="@xml/method" />
        </service>

        <activity
            android:name="app.refract.keyboard.RefractSettingsActivity"
            android:exported="true"
            android:label="@string/refract_app_name"
            android:theme="@style/Theme.Refract">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
