<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/refract_app_name"
            android:textAppearance="?android:attr/textAppearanceLarge"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/refract_product_description"
            android:textAppearance="?android:attr/textAppearanceMedium" />

        <TextView
            android:id="@+id/refract_keyboard_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:textStyle="bold" />

        <!-- Two peer actions, so a MaterialButtonGroup rather than a bare
             LinearLayout: it supplies the M3 Expressive spacing and the grouped
             shape treatment. The previous LinearLayout gave the two weighted
             buttons no margin at all, so they touched. -->
        <com.google.android.material.button.MaterialButtonGroup
            style="@style/Widget.Material3Expressive.MaterialButtonGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:spacing="8dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/refract_enable_keyboard"
                style="@style/Widget.Material3Expressive.Button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/refract_enable_keyboard" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/refract_choose_keyboard"
                style="@style/Widget.Material3Expressive.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/refract_choose_keyboard" />
        </com.google.android.material.button.MaterialButtonGroup>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/refract_pairing_title"
            android:textAppearance="?android:attr/textAppearanceMedium"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/refract_pairing_description" />

        <LinearLayout
            android:id="@+id/refract_conversations"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical" />

        <com.google.android.material.button.MaterialButtonGroup
            style="@style/Widget.Material3Expressive.MaterialButtonGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:spacing="8dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/refract_start_pairing"
                style="@style/Widget.Material3Expressive.Button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/refract_start_pairing" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/refract_join_pairing"
                style="@style/Widget.Material3Expressive.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/refract_join_pairing" />
        </com.google.android.material.button.MaterialButtonGroup>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/refract_model_title"
            android:textAppearance="?android:attr/textAppearanceMedium"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/refract_model_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp" />

        <Button
            android:id="@+id/refract_import_model"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/refract_import_model"
            android:textAllCaps="false" />

        <RadioGroup
            android:id="@+id/refract_backend"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/refract_backend_gpu"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/refract_gpu" />

            <RadioButton
                android:id="@+id/refract_backend_cpu"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/refract_cpu" />
        </RadioGroup>

        <CheckBox
            android:id="@+id/refract_preload_model"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/refract_preload" />

        <TextView
            android:id="@+id/refract_operation_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/refract_security_note"
            android:textAppearance="?android:attr/textAppearanceSmall" />
    </LinearLayout>
</ScrollView>
