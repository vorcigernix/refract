<?xml version="1.0" encoding="utf-8"?>
<!--
     Refract Keyboard: M3 Expressive functional key background.

     Functional keys (shift, delete, symbols, language switch) deliberately do NOT
     use colorSurfaceBright like the letter keys. They stay on a container tone, so
     letters read as the raised, primary targets and the outer columns recede. Pill
     silhouette reinforces the same grouping through shape.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <inset
            android:insetLeft="@dimen/refract_key_inset_horizontal"
            android:insetRight="@dimen/refract_key_inset_horizontal"
            android:insetTop="@dimen/refract_key_inset_vertical"
            android:insetBottom="@dimen/refract_key_inset_vertical">
            <shape android:shape="rectangle">
                <corners android:radius="@dimen/refract_key_functional_corner_radius" />
                <solid android:color="?attr/colorSecondaryContainer" />
            </shape>
        </inset>
    </item>
    <item>
        <inset
            android:insetLeft="@dimen/refract_key_inset_horizontal"
            android:insetRight="@dimen/refract_key_inset_horizontal"
            android:insetTop="@dimen/refract_key_inset_vertical"
            android:insetBottom="@dimen/refract_key_inset_vertical">
            <shape android:shape="rectangle">
                <corners android:radius="@dimen/refract_key_functional_corner_radius" />
                <solid android:color="?attr/colorSurfaceContainerHighest" />
            </shape>
        </inset>
    </item>
</selector>
