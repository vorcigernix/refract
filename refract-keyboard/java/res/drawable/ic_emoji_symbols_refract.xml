<?xml version="1.0" encoding="utf-8"?>
<!-- Refract Keyboard: emoji category tab icon.
     Selected/pressed uses the primary colour; at rest, on-surface-variant. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <bitmap android:src="@drawable/ic_emoji_symbols_activated_refract_base"
                android:tint="?attr/colorPrimary" />
    </item>
    <item android:state_pressed="true">
        <bitmap android:src="@drawable/ic_emoji_symbols_activated_refract_base"
                android:tint="?attr/colorPrimary" />
    </item>
    <item android:state_selected="true">
        <bitmap android:src="@drawable/ic_emoji_symbols_activated_refract_base"
                android:tint="?attr/colorPrimary" />
    </item>
    <item>
        <bitmap android:src="@drawable/ic_emoji_symbols_normal_refract_base"
                android:tint="?attr/colorOnSurfaceVariant" />
    </item>
</selector>
