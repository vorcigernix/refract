    <string name="refract_security_note" translatable="false">Prototype security: X25519 and HKDF derive the conversation key locally; Android Keystore protects it at rest. Receiving and decoding are not implemented yet.</string>

    <!-- Pairing dialogs. Kept deliberately tight: the previous copy ran to ~65 words
         of prose above the QR, which pushed the code itself off a short screen and
         buried the one instruction that matters. Each string now leads with what to
         do, then the single security caveat, in that order. -->
    <string name="refract_pair_step1_title" translatable="false">Let them scan this (1 of 2)</string>
    <string name="refract_pair_step1_body" translatable="false">Pairing as %1$s. The code carries a temporary public key and expires in 15 minutes.\n\nSend it outside the chat you plan to use \u2014 that chat could swap the code. You\u2019ll compare safety words next.</string>
    <string name="refract_pair_step2_title" translatable="false">Let %1$s scan this (2 of 2)</string>
    <string name="refract_pair_step2_body" translatable="false">Pairing as %1$s. Read these words aloud and confirm they match on both phones.\n\nIf you share the code, use a different app than your chat.</string>
    <string name="refract_pair_verify_title" translatable="false">Verify %1$s</string>
    <string name="refract_pair_verify_body" translatable="false">Read these words aloud. If any of them differs on their phone, cancel and start again.</string>
